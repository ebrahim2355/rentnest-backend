generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  phone     String?
  role      Role       @default(TENANT)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  properties     Property[]
  rentalRequests RentalRequest[]
  payments       Payment[]
  reviews        Review[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties Property[]

  @@map("categories")
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  UNAVAILABLE
}

model Property {
  id          String         @id @default(uuid())
  title       String
  description String
  location    String
  address     String
  rent        Decimal        @db.Decimal(10, 2)
  bedrooms    Int
  bathrooms   Int
  amenities   String[]
  images      String[]       @default([])
  status      PropertyStatus @default(AVAILABLE)
  isDeleted   Boolean        @default(false)
  landlordId  String
  categoryId  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  landlord       User            @relation(fields: [landlordId], references: [id])
  category       Category        @relation(fields: [categoryId], references: [id])
  rentalRequests RentalRequest[]
  reviews        Review[]

  @@index([landlordId])
  @@index([categoryId])
  @@index([location])
  @@map("properties")
}

enum RentalStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}

model RentalRequest {
  id             String       @id @default(uuid())
  propertyId     String
  tenantId       String
  moveInDate     DateTime
  durationMonths Int
  totalAmount    Decimal      @db.Decimal(10, 2)
  message        String?
  status         RentalStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  property Property  @relation(fields: [propertyId], references: [id])
  tenant   User      @relation(fields: [tenantId], references: [id])
  payments Payment[]
  review   Review?

  @@index([propertyId])
  @@index([tenantId])
  @@map("rental_requests")
}

enum PaymentProvider {
  STRIPE
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Payment {
  id              String          @id @default(uuid())
  transactionId   String          @unique
  rentalRequestId String
  userId          String
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("usd")
  method          String          @default("card")
  provider        PaymentProvider @default(STRIPE)
  status          PaymentStatus   @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  rentalRequest RentalRequest @relation(fields: [rentalRequestId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@index([rentalRequestId])
  @@index([userId])
  @@map("payments")
}

model Review {
  id              String   @id @default(uuid())
  rating          Int
  comment         String
  propertyId      String
  tenantId        String
  rentalRequestId String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property      Property      @relation(fields: [propertyId], references: [id])
  tenant        User          @relation(fields: [tenantId], references: [id])
  rentalRequest RentalRequest @relation(fields: [rentalRequestId], references: [id])

  @@index([propertyId])
  @@index([tenantId])
  @@map("reviews")
}
